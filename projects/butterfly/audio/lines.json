[
 {
  "file": "S01_03_小明.wav",
  "sid": "S01",
  "start": 1.5,
  "end": 7,
  "who": "小明",
  "text": "哇！一顆小小的卵，竟然可以變成這麼美麗的蝴蝶！",
  "audio_sec": 5.92
 },
 {
  "file": "S01_07_小美.wav",
  "sid": "S01",
  "start": 7.5,
  "end": 10,
  "who": "小美",
  "text": "我們一起來觀察蝴蝶的成長過程吧！",
  "audio_sec": 5.12
 },
 {
  "file": "S02_00_旁白.wav",
  "sid": "S02",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "蝴蝶媽媽會把卵產在幼蟲能吃的植物葉子上。",
  "audio_sec": 3.68
 },
 {
  "file": "S02_04_旁白.wav",
  "sid": "S02",
  "start": 3.8,
  "end": 8,
  "who": "旁白",
  "text": "卵非常小，形狀和顏色因種類而不同。",
  "audio_sec": 4.64
 },
 {
  "file": "S02_08_小明.wav",
  "sid": "S02",
  "start": 7.5,
  "end": 12,
  "who": "小明",
  "text": "好小喔！原來這裡藏著新的生命！",
  "audio_sec": 5.12
 },
 {
  "file": "S03_00_旁白.wav",
  "sid": "S03",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "卵孵化後，就是我們常看到的毛毛蟲。",
  "audio_sec": 3.52
 },
 {
  "file": "S03_08_毛毛蟲.wav",
  "sid": "S03",
  "start": 8,
  "end": 12,
  "who": "毛毛蟲",
  "text": "我好餓！我要快快長大！",
  "audio_sec": 2.4
 },
 {
  "file": "S04_00_旁白.wav",
  "sid": "S04",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "牠最重要的工作，就是吃葉子。",
  "audio_sec": 2.72
 },
 {
  "file": "S04_04_旁白.wav",
  "sid": "S04",
  "start": 4,
  "end": 9,
  "who": "旁白",
  "text": "身體長大好幾次，期間會脫皮。",
  "audio_sec": 3.2
 },
 {
  "file": "S04_09_旁白.wav",
  "sid": "S04",
  "start": 9,
  "end": 12,
  "who": "旁白",
  "text": "吃葉子，長大，脫皮，再長大！",
  "audio_sec": 3.52
 },
 {
  "file": "S05_00_旁白.wav",
  "sid": "S05",
  "start": 0,
  "end": 5,
  "who": "旁白",
  "text": "長大以後，牠找到安全的地方，變成蛹。",
  "audio_sec": 3.68
 },
 {
  "file": "S05_05_旁白.wav",
  "sid": "S05",
  "start": 5,
  "end": 8,
  "who": "旁白",
  "text": "外表安靜，裡面正在進行大變化。",
  "audio_sec": 3.04
 },
 {
  "file": "S05_08_小美.wav",
  "sid": "S05",
  "start": 8,
  "end": 12,
  "who": "小美",
  "text": "哇！看起來很安靜，裡面竟然正在變身啊！",
  "audio_sec": 5.92
 },
 {
  "file": "S06_00_旁白.wav",
  "sid": "S06",
  "start": 0,
  "end": 3,
  "who": "旁白",
  "text": "經過一段時間，蛹會裂開。",
  "audio_sec": 2.4
 },
 {
  "file": "S06_08_旁白.wav",
  "sid": "S06",
  "start": 8,
  "end": 12,
  "who": "旁白",
  "text": "牠把體液送進翅膀，慢慢展開。",
  "audio_sec": 3.52
 },
 {
  "file": "S07_00_旁白.wav",
  "sid": "S07",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "等翅膀變乾、變硬，就可以飛翔了！",
  "audio_sec": 3.68
 },
 {
  "file": "S07_07_小明.wav",
  "sid": "S07",
  "start": 4.0,
  "end": 10,
  "who": "小明",
  "text": "太棒了！毛毛蟲真的變成美麗的蝴蝶了！",
  "audio_sec": 5.6
 },
 {
  "file": "S08_00_蝴蝶.wav",
  "sid": "S08",
  "start": 0,
  "end": 4,
  "who": "蝴蝶",
  "text": "花蜜好好吃！大自然真是太棒了！",
  "audio_sec": 4.96
 },
 {
  "file": "S08_04_旁白.wav",
  "sid": "S08",
  "start": 4,
  "end": 8,
  "who": "旁白",
  "text": "蝴蝶吸食花蜜，也幫植物傳播花粉。",
  "audio_sec": 3.36
 },
 {
  "file": "S08_08_小美.wav",
  "sid": "S08",
  "start": 8,
  "end": 12,
  "who": "小美",
  "text": "原來蝴蝶不只是漂亮，也是大自然重要的一員！",
  "audio_sec": 5.6
 },
 {
  "file": "S09_00_旁白.wav",
  "sid": "S09",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "長大成熟後，牠們會交配。",
  "audio_sec": 2.56
 },
 {
  "file": "S09_04_旁白.wav",
  "sid": "S09",
  "start": 4,
  "end": 8,
  "who": "旁白",
  "text": "雌蝶再產下新的卵，開啟下一代。",
  "audio_sec": 2.72
 },
 {
  "file": "S09_08_旁白.wav",
  "sid": "S09",
  "start": 8,
  "end": 12,
  "who": "旁白",
  "text": "卵，幼蟲，蛹，成蝶，周而復始。",
  "audio_sec": 4.64
 },
 {
  "file": "S10_00_小明.wav",
  "sid": "S10",
  "start": 0,
  "end": 7,
  "who": "小明",
  "text": "小小的生命，連結著大大的自然，讓我們一起守護美麗的地球吧！",
  "audio_sec": 7.84
 },
 {
  "file": "S10_10_旁白.wav",
  "sid": "S10",
  "start": 10,
  "end": 12,
  "who": "旁白",
  "text": "讓更多生命繼續飛翔！",
  "audio_sec": 1.92
 }
]