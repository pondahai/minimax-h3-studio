[
 {
  "file": "S01_00_悟空.wav",
  "sid": "S01",
  "start": 0,
  "end": 5,
  "who": "悟空",
  "text": "這次我們來到台北！聽說這裡有很多新的科技和AI應用！",
  "audio_sec": 4.16
 },
 {
  "file": "S01_05_悟淨.wav",
  "sid": "S01",
  "start": 5,
  "end": 9,
  "who": "悟淨",
  "text": "台北101好壯觀！也是一個充滿創新的城市！",
  "audio_sec": 4.48
 },
 {
  "file": "S01_09_鸚鵡.wav",
  "sid": "S01",
  "start": 9,
  "end": 12,
  "who": "鸚鵡",
  "text": "我們要尋找第六枚印章！",
  "audio_sec": 2.56
 },
 {
  "file": "S02_00_AI小助手.wav",
  "sid": "S02",
  "start": 0,
  "end": 3,
  "who": "AI小助手",
  "text": "大家好！我是AI小助手！",
  "audio_sec": 2.24
 },
 {
  "file": "S02_03_AI小助手.wav",
  "sid": "S02",
  "start": 3,
  "end": 9,
  "who": "AI小助手",
  "text": "我可以回答問題、幫忙查資料、生成圖片，還可以幫忙想點子！",
  "audio_sec": 4.8
 },
 {
  "file": "S02_09_八戒.wav",
  "sid": "S02",
  "start": 9,
  "end": 12,
  "who": "八戒",
  "text": "哇！AI好厲害！什麼都會嗎？",
  "audio_sec": 2.88
 },
 {
  "file": "S03_00_悟空.wav",
  "sid": "S03",
  "start": 0,
  "end": 3,
  "who": "悟空",
  "text": "我們請AI規劃台北一日遊吧！",
  "audio_sec": 2.24
 },
 {
  "file": "S03_03_AI小助手.wav",
  "sid": "S03",
  "start": 3,
  "end": 8,
  "who": "AI小助手",
  "text": "推薦行程：台北101、象山步道、永康街美食、華山文創園區、大稻埕。",
  "audio_sec": 6.4
 },
 {
  "file": "S03_08_悟淨.wav",
  "sid": "S03",
  "start": 8,
  "end": 12,
  "who": "悟淨",
  "text": "好快！景點、交通、美食，還有地圖都有了！",
  "audio_sec": 4.48
 },
 {
  "file": "S04_00_八戒.wav",
  "sid": "S04",
  "start": 0,
  "end": 4,
  "who": "八戒",
  "text": "哇！這張圖片好漂亮！這是台北的真實景色嗎？",
  "audio_sec": 4.0
 },
 {
  "file": "S04_04_悟淨.wav",
  "sid": "S04",
  "start": 4,
  "end": 9,
  "who": "悟淨",
  "text": "看起來很像，但可能是AI生成的，不一定是真的。我們需要查證！",
  "audio_sec": 5.44
 },
 {
  "file": "S04_09_悟空.wav",
  "sid": "S04",
  "start": 9,
  "end": 12,
  "who": "悟空",
  "text": "原來AI也可能出錯，或是編造內容！",
  "audio_sec": 2.88
 },
 {
  "file": "S05_00_悟淨.wav",
  "sid": "S05",
  "start": 0,
  "end": 3,
  "who": "悟淨",
  "text": "我們可以用不同的方式查證：",
  "audio_sec": 2.4
 },
 {
  "file": "S05_03_悟淨.wav",
  "sid": "S05",
  "start": 3,
  "end": 9,
  "who": "悟淨",
  "text": "第一，比較多個網站的資料；第二，看官方網站或可信的來源；",
  "audio_sec": 5.76
 },
 {
  "file": "S06_00_悟淨.wav",
  "sid": "S06",
  "start": 0,
  "end": 6,
  "who": "悟淨",
  "text": "第三，檢查圖片是不是真的；第四，想一想內容合不合理。",
  "audio_sec": 5.12
 },
 {
  "file": "S06_06_悟空.wav",
  "sid": "S06",
  "start": 6,
  "end": 9,
  "who": "悟空",
  "text": "原來查證這麼重要！",
  "audio_sec": 1.76
 },
 {
  "file": "S07_00_悟空.wav",
  "sid": "S07",
  "start": 0,
  "end": 4,
  "who": "悟空",
  "text": "讓我們用AI來設計一張『台灣環保宣傳海報』吧！",
  "audio_sec": 3.84
 },
 {
  "file": "S07_04_AI小助手.wav",
  "sid": "S07",
  "start": 4,
  "end": 6,
  "who": "AI小助手",
  "text": "好的！你想要什麼主題？",
  "audio_sec": 2.08
 },
 {
  "file": "S07_06_悟空.wav",
  "sid": "S07",
  "start": 6,
  "end": 8,
  "who": "悟空",
  "text": "守護台灣，從減塑開始！",
  "audio_sec": 2.24
 },
 {
  "file": "S07_08_八戒.wav",
  "sid": "S07",
  "start": 8,
  "end": 12,
  "who": "八戒",
  "text": "太棒了！還可以用來做學校的宣傳活動！",
  "audio_sec": 3.52
 },
 {
  "file": "S08_00_悟淨.wav",
  "sid": "S08",
  "start": 0,
  "end": 2,
  "who": "悟淨",
  "text": "我們使用AI時，要記得：",
  "audio_sec": 2.56
 },
 {
  "file": "S08_02_AI小助手.wav",
  "sid": "S08",
  "start": 2,
  "end": 6,
  "who": "AI小助手",
  "text": "第一，把AI當作助手，不是全部依賴。",
  "audio_sec": 3.36
 },
 {
  "file": "S08_06_悟淨.wav",
  "sid": "S08",
  "start": 6,
  "end": 9,
  "who": "悟淨",
  "text": "第二，重要的決定要自己思考。",
  "audio_sec": 3.36
 },
 {
  "file": "S08_09_八戒.wav",
  "sid": "S08",
  "start": 9,
  "end": 12,
  "who": "八戒",
  "text": "第三，尊重別人的創作和隱私。",
  "audio_sec": 3.04
 },
 {
  "file": "S09_00_鸚鵡.wav",
  "sid": "S09",
  "start": 0,
  "end": 3,
  "who": "鸚鵡",
  "text": "第四，不輸入個人資料。",
  "audio_sec": 3.36
 },
 {
  "file": "S09_03_悟空.wav",
  "sid": "S09",
  "start": 3,
  "end": 6,
  "who": "悟空",
  "text": "第五，用AI來學習和創造，而不是作弊！",
  "audio_sec": 3.2
 },
 {
  "file": "S09_06_悟空.wav",
  "sid": "S09",
  "start": 6,
  "end": 10,
  "who": "悟空",
  "text": "AI可以讓我們更厲害，但真正的想法和決定，還是要靠我們自己！",
  "audio_sec": 4.16
 },
 {
  "file": "S09_10_鸚鵡.wav",
  "sid": "S09",
  "start": 10,
  "end": 12,
  "who": "鸚鵡",
  "text": "對！腦袋是自己的！",
  "audio_sec": 2.88
 },
 {
  "file": "S10_00_AI小助手.wav",
  "sid": "S10",
  "start": 0,
  "end": 3,
  "who": "AI小助手",
  "text": "AI已經在很多地方幫助我們。",
  "audio_sec": 2.24
 },
 {
  "file": "S10_03_AI小助手.wav",
  "sid": "S10",
  "start": 3,
  "end": 8,
  "who": "AI小助手",
  "text": "學習上，可以解釋難懂的概念、練習英文；",
  "audio_sec": 3.2
 },
 {
  "file": "S10_08_AI小助手.wav",
  "sid": "S10",
  "start": 8,
  "end": 12,
  "who": "AI小助手",
  "text": "健康上，可以協助醫生分析，提醒健康習慣；",
  "audio_sec": 3.36
 },
 {
  "file": "S11_00_AI小助手.wav",
  "sid": "S11",
  "start": 0,
  "end": 3,
  "who": "AI小助手",
  "text": "交通上，可以導航、預測班次；",
  "audio_sec": 2.56
 },
 {
  "file": "S11_03_AI小助手.wav",
  "sid": "S11",
  "start": 3,
  "end": 7,
  "who": "AI小助手",
  "text": "環境上，可以監測天氣、節能減碳。",
  "audio_sec": 2.72
 },
 {
  "file": "S11_07_悟空.wav",
  "sid": "S11",
  "start": 7,
  "end": 12,
  "who": "悟空",
  "text": "AI可以幫助解決真的問題，讓世界變得更好！",
  "audio_sec": 3.36
 },
 {
  "file": "S12_00_鸚鵡.wav",
  "sid": "S12",
  "start": 0,
  "end": 6,
  "who": "鸚鵡",
  "text": "小任務：用AI解決一個台北的問題！",
  "audio_sec": 5.76
 },
 {
  "file": "S12_06_鸚鵡.wav",
  "sid": "S12",
  "start": 6,
  "end": 12,
  "who": "鸚鵡",
  "text": "選個主題，用AI找資料，再加上自己的創意！",
  "audio_sec": 5.12
 },
 {
  "file": "S13_00_悟空.wav",
  "sid": "S13",
  "start": 0,
  "end": 5,
  "who": "悟空",
  "text": "我們選擇『讓台北更適合小朋友遊玩』！",
  "audio_sec": 2.72
 },
 {
  "file": "S13_05_八戒.wav",
  "sid": "S13",
  "start": 5,
  "end": 8,
  "who": "八戒",
  "text": "我來想點子！",
  "audio_sec": 1.44
 },
 {
  "file": "S13_08_悟淨.wav",
  "sid": "S13",
  "start": 8,
  "end": 11,
  "who": "悟淨",
  "text": "我來設計圖片！",
  "audio_sec": 1.28
 },
 {
  "file": "S14_00_悟空.wav",
  "sid": "S14",
  "start": 0,
  "end": 5,
  "who": "悟空",
  "text": "我們用AI整理資料，再加上自己的想法，做出這張地圖！",
  "audio_sec": 4.32
 },
 {
  "file": "S14_05_悟淨.wav",
  "sid": "S14",
  "start": 5,
  "end": 11,
  "who": "悟淨",
  "text": "有適合小朋友的景點、安全的路線，還有好吃又健康的餐廳！",
  "audio_sec": 4.8
 },
 {
  "file": "S15_00_鸚鵡.wav",
  "sid": "S15",
  "start": 0,
  "end": 7,
  "who": "鸚鵡",
  "text": "AI給我們靈感，但真正讓它變得特別的，是我們的觀察和創意！",
  "audio_sec": 6.24
 },
 {
  "file": "S16_00_鸚鵡.wav",
  "sid": "S16",
  "start": 0,
  "end": 6,
  "who": "鸚鵡",
  "text": "善用AI，不盲從，保持好奇與思考，",
  "audio_sec": 6.56
 },
 {
  "file": "S16_06_鸚鵡.wav",
  "sid": "S16",
  "start": 6,
  "end": 12,
  "who": "鸚鵡",
  "text": "用創意解決問題，讓科技成為讓世界更好的力量。",
  "audio_sec": 6.56
 },
 {
  "file": "S17_00_悟空.wav",
  "sid": "S17",
  "start": 0,
  "end": 4,
  "who": "悟空",
  "text": "太好了！我們得到第六枚印章『思考印』了！",
  "audio_sec": 3.68
 },
 {
  "file": "S17_04_八戒.wav",
  "sid": "S17",
  "start": 4,
  "end": 7,
  "who": "八戒",
  "text": "原來AI不是魔法，而是工具！",
  "audio_sec": 2.56
 },
 {
  "file": "S17_07_悟淨.wav",
  "sid": "S17",
  "start": 7,
  "end": 11,
  "who": "悟淨",
  "text": "只要正確使用，我們就能創造更多可能！",
  "audio_sec": 4.0
 },
 {
