[
 {
  "file": "S01_03_小明.wav",
  "sid": "S01",
  "start": 3,
  "end": 7,
  "who": "小明",
  "text": "哇！這塊海綿這麼大，卻比這顆石頭輕！",
  "audio_sec": 4.96
 },
 {
  "file": "S01_07_小美.wav",
  "sid": "S01",
  "start": 7,
  "end": 12,
  "who": "小美",
  "text": "奇怪！大的東西一定比較重嗎？",
  "audio_sec": 5.12
 },
 {
  "file": "S02_00_旁白.wav",
  "sid": "S02",
  "start": 0,
  "end": 5,
  "who": "旁白",
  "text": "原來，東西的輕重不只看大小，",
  "audio_sec": 3.2
 },
 {
  "file": "S02_05_旁白.wav",
  "sid": "S02",
  "start": 5,
  "end": 10,
  "who": "旁白",
  "text": "還要看裡面塞了多少東西，這就是密度！",
  "audio_sec": 3.68
 },
 {
  "file": "S03_00_小明.wav",
  "sid": "S03",
  "start": 0,
  "end": 4,
  "who": "小明",
  "text": "你看，這三個方塊一樣大，",
  "audio_sec": 3.52
 },
 {
  "file": "S03_04_小明.wav",
  "sid": "S03",
  "start": 4,
  "end": 8,
  "who": "小明",
  "text": "可是重量完全不一樣！",
  "audio_sec": 3.04
 },
 {
  "file": "S04_00_小美.wav",
  "sid": "S04",
  "start": 0,
  "end": 4,
  "who": "小美",
  "text": "因為它們裡面的東西，塞得緊不緊不一樣！",
  "audio_sec": 5.92
 },
 {
  "file": "S04_04_旁白.wav",
  "sid": "S04",
  "start": 4,
  "end": 8,
  "who": "旁白",
  "text": "密度，就是相同體積裡有多少質量。",
  "audio_sec": 3.52
 },
 {
  "file": "S04_08_旁白.wav",
  "sid": "S04",
  "start": 8,
  "end": 12,
  "who": "旁白",
  "text": "塞得越緊，密度越大，通常也越重。",
  "audio_sec": 3.04
 },
 {
  "file": "S05_00_旁白.wav",
  "sid": "S05",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "這兩個盒子一樣大，",
  "audio_sec": 1.76
 },
 {
  "file": "S05_04_旁白.wav",
  "sid": "S05",
  "start": 4,
  "end": 8,
  "who": "旁白",
  "text": "右邊塞進更多球，裡面的東西比較多，密度就比較大。",
  "audio_sec": 4.96
 },
 {
  "file": "S05_08_小明.wav",
  "sid": "S05",
  "start": 8,
  "end": 12,
  "who": "小明",
  "text": "密度等於質量除以體積！",
  "audio_sec": 3.36
 },
 {
  "file": "S06_00_小明.wav",
  "sid": "S06",
  "start": 0,
  "end": 3,
  "who": "小明",
  "text": "我們把東西放進水裡看看！",
  "audio_sec": 2.88
 },
 {
  "file": "S06_03_旁白.wav",
  "sid": "S06",
  "start": 3,
  "end": 7,
  "who": "旁白",
  "text": "木頭的密度比水小，會浮起來。",
  "audio_sec": 3.04
 },
 {
  "file": "S06_07_旁白.wav",
  "sid": "S06",
  "start": 7,
  "end": 12,
  "who": "旁白",
  "text": "石頭的密度比水大，就沉下去了。",
  "audio_sec": 3.2
 },
 {
