 },
 {
  "file": "S08_00_旁白.wav",
  "sid": "S08",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "軟木塞和積木浮起來了，",
  "audio_sec": 2.24
 },
 {
  "file": "S08_04_旁白.wav",
  "sid": "S08",
  "start": 4,
  "end": 8,
  "who": "旁白",
  "text": "硬幣、湯匙和石頭沉下去。",
  "audio_sec": 3.04
 },
 {
  "file": "S08_08_小明.wav",
  "sid": "S08",
  "start": 8,
  "end": 12,
  "who": "小明",
  "text": "跟我猜的一樣！",
  "audio_sec": 2.08
 },
 {
  "file": "S09_00_旁白.wav",
  "sid": "S09",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "在杯子裡倒進蜂蜜、水，再倒油。",
  "audio_sec": 3.68
 },
 {
  "file": "S09_08_小明.wav",
  "sid": "S09",
  "start": 8,
  "end": 12,
  "who": "小明",
  "text": "哇！明明都是液體，為什麼分成三層？",
  "audio_sec": 5.28
 },
 {
  "file": "S10_00_小美.wav",
  "sid": "S10",
  "start": 0,
  "end": 6,
  "who": "小美",
  "text": "因為密度不同！密度大的蜂蜜在最下面，",
  "audio_sec": 6.24
 },
 {
  "file": "S10_06_小美.wav",
  "sid": "S10",
  "start": 6,
  "end": 12,
  "who": "小美",
  "text": "密度小的油在最上面。",
  "audio_sec": 3.68
 },
 {
