[
 {
  "file": "S01_00_悟空.wav",
  "sid": "S01",
  "start": 0,
  "end": 6,
  "who": "悟空",
  "text": "這一集我們要搭台灣高鐵，尋找第五枚印章『科學印』！",
  "audio_sec": 4.32
 },
 {
  "file": "S01_06_八戒.wav",
  "sid": "S01",
  "start": 6,
  "end": 9,
  "who": "八戒",
  "text": "聽說高鐵又快又舒服，真期待！",
  "audio_sec": 3.2
 },
 {
  "file": "S01_09_悟淨.wav",
  "sid": "S01",
  "start": 9,
  "end": 12,
  "who": "悟淨",
  "text": "我們要找出高鐵這麼快的祕密！",
  "audio_sec": 2.24
 },
 {
  "file": "S02_00_八戒.wav",
  "sid": "S02",
  "start": 0,
  "end": 4,
  "who": "八戒",
  "text": "哇！座位好舒服！車廂好乾淨！",
  "audio_sec": 2.88
 },
 {
  "file": "S02_04_悟淨.wav",
  "sid": "S02",
  "start": 4,
  "end": 10,
  "who": "悟淨",
  "text": "等一下就要出發了，大家坐好，不要在車廂裡亂跑喔！",
  "audio_sec": 3.36
 },
 {
  "file": "S02_10_鸚鵡.wav",
  "sid": "S02",
  "start": 10,
  "end": 12,
  "who": "鸚鵡",
  "text": "出發囉！",
  "audio_sec": 1.76
 },
 {
  "file": "S03_00_悟空.wav",
  "sid": "S03",
  "start": 0,
  "end": 4,
  "who": "悟空",
  "text": "哇！好快啊！風景一下子就跑過去了！",
  "audio_sec": 3.04
 },
 {
  "file": "S03_04_悟淨.wav",
  "sid": "S03",
  "start": 4,
  "end": 9,
  "who": "悟淨",
  "text": "高鐵最快時速可以到三百公里！為什麼這麼快？",
  "audio_sec": 3.04
 },
 {
  "file": "S03_09_八戒.wav",
  "sid": "S03",
  "start": 9,
  "end": 12,
  "who": "八戒",
  "text": "好像在飛一樣！是魔法嗎？",
  "audio_sec": 2.24
 },
 {
  "file": "S04_00_服務員.wav",
  "sid": "S04",
  "start": 0,
  "end": 4,
  "who": "服務員",
  "text": "高鐵這麼快，主要有幾個原因。",
  "audio_sec": 3.52
 },
 {
  "file": "S04_04_服務員.wav",
  "sid": "S04",
  "start": 4,
  "end": 8,
  "who": "服務員",
  "text": "第一，流線型車頭可以減少空氣阻力。",
  "audio_sec": 3.36
 },
 {
  "file": "S04_08_服務員.wav",
  "sid": "S04",
  "start": 8,
  "end": 12,
  "who": "服務員",
  "text": "第二，專用的高鐵軌道又直又平。",
  "audio_sec": 3.36
 },
 {
  "file": "S05_00_服務員.wav",
  "sid": "S05",
  "start": 0,
  "end": 4,
  "who": "服務員",
  "text": "第三，先進的電力系統提供強大動力。",
  "audio_sec": 3.84
 },
 {
  "file": "S05_04_服務員.wav",
  "sid": "S05",
  "start": 4,
  "end": 9,
  "who": "服務員",
  "text": "第四，電腦自動控制，讓列車更安全穩定。",
  "audio_sec": 4.32
 },
 {
  "file": "S05_09_悟空.wav",
  "sid": "S05",
  "start": 9,
  "end": 12,
  "who": "悟空",
  "text": "原來不是魔法，是科學和工程的結合！",
  "audio_sec": 3.2
 },
 {
  "file": "S06_00_服務員.wav",
  "sid": "S06",
  "start": 0,
  "end": 5,
  "who": "服務員",
  "text": "流線型的車頭，可以讓空氣更順利地流過，減少空氣阻力，",
  "audio_sec": 4.96
 },
 {
  "file": "S06_05_服務員.wav",
  "sid": "S06",
  "start": 5,
  "end": 8,
  "who": "服務員",
  "text": "讓列車跑得更快、更省電。",
  "audio_sec": 3.04
 },
 {
  "file": "S06_08_悟空.wav",
  "sid": "S06",
  "start": 8,
  "end": 12,
  "who": "悟空",
  "text": "像魚一樣的形狀，可以更快往前游！",
  "audio_sec": 2.88
 },
 {
  "file": "S07_00_服務員.wav",
  "sid": "S07",
  "start": 0,
  "end": 7,
  "who": "服務員",
  "text": "高鐵也有很多安全設計。專用軌道，不會和汽車、行人交叉；",
  "audio_sec": 6.24
 },
 {
  "file": "S07_07_服務員.wav",
  "sid": "S07",
  "start": 7,
  "end": 12,
  "who": "服務員",
  "text": "全程電腦控制，監測速度和距離。",
  "audio_sec": 3.2
 },
 {
  "file": "S08_00_服務員.wav",
  "sid": "S08",
  "start": 0,
  "end": 4,
  "who": "服務員",
  "text": "遇到地震，會自動減速或停止；",
  "audio_sec": 2.56
 },
 {
  "file": "S08_04_服務員.wav",
  "sid": "S08",
  "start": 4,
  "end": 8,
  "who": "服務員",
  "text": "還會定期檢查和維修，確保安全。",
  "audio_sec": 3.04
 },
 {
  "file": "S08_08_鸚鵡.wav",
  "sid": "S08",
  "start": 8,
  "end": 12,
  "who": "鸚鵡",
  "text": "所以我們可以很快，也很安全！",
  "audio_sec": 2.88
 },
 {
  "file": "S09_00_悟淨.wav",
  "sid": "S09",
  "start": 0,
  "end": 5,
  "who": "悟淨",
  "text": "從台北到台南，高鐵只要大約一個半到兩小時，",
  "audio_sec": 4.0
 },
 {
  "file": "S09_05_悟淨.wav",
  "sid": "S09",
  "start": 5,
  "end": 10,
  "who": "悟淨",
  "text": "就可以看到不同的城市、田野、海岸和山景。",
  "audio_sec": 4.64
 },
 {
