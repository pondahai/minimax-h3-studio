[
 {
  "file": "S01_00_小明.wav",
  "sid": "S01",
  "start": 0,
  "end": 4,
  "who": "小明",
  "text": "哇！月亮變成紅色的了！",
  "audio_sec": 3.2
 },
 {
  "file": "S01_04_小美.wav",
  "sid": "S01",
  "start": 4,
  "end": 7,
  "who": "小美",
  "text": "這是什麼現象呢？",
  "audio_sec": 3.04
 },
 {
  "file": "S01_07_小明.wav",
  "sid": "S01",
  "start": 7,
  "end": 12,
  "who": "小明",
  "text": "這叫月食，是地球的影子遮住了月亮！",
  "audio_sec": 4.8
 },
 {
  "file": "S02_00_旁白.wav",
  "sid": "S02",
  "start": 0,
  "end": 5,
  "who": "旁白",
  "text": "滿月的時候，太陽、地球、月球幾乎排成一直線，",
  "audio_sec": 5.12
 },
 {
  "file": "S02_05_旁白.wav",
  "sid": "S02",
  "start": 5,
  "end": 8,
  "who": "旁白",
  "text": "地球擋住太陽的光，",
  "audio_sec": 2.24
 },
 {
  "file": "S02_08_旁白.wav",
  "sid": "S02",
  "start": 8,
  "end": 12,
  "who": "旁白",
  "text": "月球就走進地球的影子裡。",
  "audio_sec": 2.4
 },
 {
  "file": "S03_00_旁白.wav",
  "sid": "S03",
  "start": 0,
  "end": 3,
  "who": "旁白",
  "text": "地球的影子有兩層：",
  "audio_sec": 2.08
 },
 {
  "file": "S03_03_旁白.wav",
  "sid": "S03",
  "start": 3,
  "end": 7,
  "who": "旁白",
  "text": "外圍比較淡的叫半影，還有一些陽光。",
  "audio_sec": 3.36
 },
 {
  "file": "S03_07_旁白.wav",
  "sid": "S03",
  "start": 7,
  "end": 12,
  "who": "旁白",
  "text": "中間最暗的叫本影，太陽光幾乎完全被擋住。",
  "audio_sec": 4.48
 },
 {
  "file": "S04_00_旁白.wav",
  "sid": "S04",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "整個月球走進本影，就是月全食。",
  "audio_sec": 2.88
 },
 {
  "file": "S04_04_旁白.wav",
  "sid": "S04",
  "start": 4,
  "end": 10,
  "who": "旁白",
  "text": "陽光穿過地球的大氣，紅光被彎進影子裡，把月亮染紅。",
  "audio_sec": 5.12
 },
 {
  "file": "S05A_00_旁白.wav",
  "sid": "S05A",
  "start": 0,
  "end": 6,
  "who": "旁白",
  "text": "只有一部分進入本影，月亮像被咬掉彎彎的一塊，是月偏食；",
  "audio_sec": 5.44
 },
 {
  "file": "S05B_00_旁白.wav",
  "sid": "S05B",
  "start": 0,
  "end": 6,
  "who": "旁白",
  "text": "只經過半影，月亮只暗一點點，叫半影月食。",
  "audio_sec": 4.64
 },
 {
  "file": "S06_00_旁白.wav",
  "sid": "S06",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "月球的軌道斜了大約五度，",
  "audio_sec": 2.56
 },
 {
  "file": "S06_04_旁白.wav",
  "sid": "S06",
  "start": 4,
  "end": 10,
  "who": "旁白",
  "text": "所以大部分滿月，月球會從影子上面或下面經過。",
  "audio_sec": 4.48
 },
 {
  "file": "S07_00_小美.wav",
  "sid": "S07",
  "start": 0,
  "end": 4,
  "who": "小美",
  "text": "所以不是每次滿月都有月食，",
  "audio_sec": 4.64
 },
 {
  "file": "S07_04_小美.wav",
  "sid": "S07",
  "start": 4,
  "end": 8,
  "who": "小美",
  "text": "要剛好排成一直線才會發生喔！",
  "audio_sec": 4.8
 },
 {
  "file": "S08_00_旁白.wav",
  "sid": "S08",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "日食時，月球離地球比較遠，",
  "audio_sec": 3.36
 },
 {
  "file": "S08_04_旁白.wav",
  "sid": "S08",
  "start": 4,
  "end": 8,
  "who": "旁白",
  "text": "看起來比太陽小，遮不住整個太陽，",
  "audio_sec": 3.04
 },
 {
  "file": "S08_08_旁白.wav",
  "sid": "S08",
  "start": 8,
  "end": 12,
  "who": "旁白",
  "text": "就留下一圈光環。",
  "audio_sec": 1.76
 },
 {
  "file": "S09_00_旁白.wav",
  "sid": "S09",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "月食時，地球的本影比月球大得多，",
  "audio_sec": 4.0
 },
 {
  "file": "S09_04_旁白.wav",
  "sid": "S09",
  "start": 4,
  "end": 8,
  "who": "旁白",
  "text": "能把整個月球罩住，",
  "audio_sec": 2.08
 },
 {
  "file": "S09_08_旁白.wav",
  "sid": "S09",
  "start": 8,
  "end": 12,
  "who": "旁白",
  "text": "所以沒有月環食。",
  "audio_sec": 2.08
 },
 {
  "file": "S10_00_小明.wav",
  "sid": "S10",
  "start": 0,
  "end": 4,
  "who": "小明",
  "text": "月食是地球擋住太陽光，",
  "audio_sec": 3.2
 },
 {
  "file": "S10_04_小明.wav",
  "sid": "S10",
  "start": 4,
  "end": 8,
  "who": "小明",
  "text": "月亮走進地球的影子，",
  "audio_sec": 2.88
 },
 {
  "file": "S10_08_小明.wav",
  "sid": "S10",
  "start": 8,
  "end": 12,
  "who": "小明",
  "text": "有月全食、月偏食和半影月食！",
  "audio_sec": 4.48
 },
 {
  "file": "S11_00_小明.wav",
  "sid": "S11",
  "start": 0,
  "end": 4,
  "who": "小明",
  "text": "看月食很安全，用眼睛就能看，",
  "audio_sec": 4.0
 },
 {
  "file": "S11_04_小明.wav",
  "sid": "S11",
  "start": 4,
  "end": 8,
  "who": "小明",
  "text": "下次月食，記得和家人一起看喔！",
  "audio_sec": 4.16
 }
]