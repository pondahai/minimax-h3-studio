 },
 {
  "file": "S02_08_メイ.wav",
  "sid": "S02",
  "start": 8,
  "end": 12,
  "who": "メイ",
  "text": "ほんと？でも、何も見えないよ！",
  "audio_sec": 4.8
 },
 {
  "file": "S03_00_ミン.wav",
  "sid": "S03",
  "start": 0,
  "end": 3,
  "who": "ミン",
  "text": "コップの外は冷たいから、",
  "audio_sec": 3.04
 },
 {
  "file": "S03_03_ミン.wav",
  "sid": "S03",
  "start": 3,
  "end": 8,
  "who": "ミン",
  "text": "水蒸気がふれると、小さな水滴になるんだ！",
  "audio_sec": 4.64
 },
 {
  "file": "S03_08_メイ.wav",
  "sid": "S03",
  "start": 8,
  "end": 12,
  "who": "メイ",
  "text": "水はコップからもれてたんじゃないんだ！",
  "audio_sec": 4.32
 },
 {
  "file": "S04_00_リン博士.wav",
  "sid": "S04",
  "start": 0,
  "end": 4,
  "who": "リン博士",
  "text": "同じコップを二つ使おう。",
  "audio_sec": 2.24
 },
 {
  "file": "S04_04_リン博士.wav",
  "sid": "S04",
  "start": 4,
  "end": 8,
  "who": "リン博士",
  "text": "一つは氷水、一つは常温の水。",
  "audio_sec": 3.68
 },
 {
  "file": "S04_08_リン博士.wav",
  "sid": "S04",
  "start": 8,
  "end": 12,
  "who": "リン博士",
  "text": "コップの外がどうちがうか、見てみよう。",
  "audio_sec": 3.04
 },
 {
  "file": "S05_00_メイ.wav",
  "sid": "S05",
  "start": 0,
  "end": 5,
  "who": "メイ",
  "text": "見て！氷水のコップに水滴がいっぱい！",
  "audio_sec": 6.08
 },
 {
  "file": "S05_05_ミン.wav",
  "sid": "S05",
  "start": 5,
  "end": 8,
  "who": "ミン",
  "text": "常温のコップはかわいてる！",
  "audio_sec": 3.04
 },
 {
  "file": "S05_08_メイ.wav",
  "sid": "S05",
  "start": 8,
  "end": 12,
  "who": "メイ",
  "text": "氷水でコップが冷えたからだね！",
  "audio_sec": 4.8
 },
 {
  "file": "S06_00_ナレーター.wav",
  "sid": "S06",
  "start": 0,
  "end": 4,
  "who": "ナレーター",
  "text": "朝、葉っぱにつく露や、",
  "audio_sec": 2.56
 },
 {
  "file": "S06_04_ナレーター.wav",
  "sid": "S06",
  "start": 4,
  "end": 8,
  "who": "ナレーター",
  "text": "窓につく水滴は、",
  "audio_sec": 2.24
 },
 {
  "file": "S06_08_ナレーター.wav",
  "sid": "S06",
  "start": 8,
  "end": 12,
  "who": "ナレーター",
  "text": "水蒸気が冷えて凝結したものです。",
  "audio_sec": 2.72
 },
 {
  "file": "S07_00_リン博士.wav",
  "sid": "S07",
  "start": 0,
  "end": 4,
  "who": "リン博士",
  "text": "空の雲も、水蒸気が高い空で冷えて、",
  "audio_sec": 3.84
 },
 {
  "file": "S07_04_リン博士.wav",
  "sid": "S07",
  "start": 4,
  "end": 8,
  "who": "リン博士",
  "text": "小さな水滴になってできるんだ。",
  "audio_sec": 2.08
 },
 {
  "file": "S07_08_リン博士.wav",
  "sid": "S07",
  "start": 8,
  "end": 12,
  "who": "リン博士",
  "text": "水の循環の、大切な一部だよ！",
  "audio_sec": 2.88
 },
 {
  "file": "S08_00_ミン.wav",
  "sid": "S08",
  "start": 0,
  "end": 4,
  "who": "ミン",
  "text": "空気には、見えない水蒸気があって、",
  "audio_sec": 4.0
 },
 {
  "file": "S08_04_ミン.wav",
  "sid": "S08",
  "start": 4,
  "end": 8,
  "who": "ミン",
  "text": "冷たいコップにふれると水滴になる。",
  "audio_sec": 3.68
 },
 {
  "file": "S08_08_ミン.wav",
  "sid": "S08",
  "start": 8,
  "end": 12,
  "who": "ミン",
  "text": "水は空気から来たんだ。もれてないよ！",
  "audio_sec": 4.48
 },
 {
  "file": "S09_00_リン博士.wav",
  "sid": "S09",
  "start": 0,
  "end": 4,
  "who": "リン博士",
  "text": "どうして冷たいコップに水滴がつくのかな？",
  "audio_sec": 3.2
 },
 {
  "file": "S09_04_リン博士.wav",
  "sid": "S09",
  "start": 4,
  "end": 8,
  "who": "リン博士",
  "text": "コップが冷たいほど、まわりの空気も冷えて、",
  "audio_sec": 3.68
 },
 {
  "file": "S09_08_リン博士.wav",
  "sid": "S09",
  "start": 8,
  "end": 12,
  "who": "リン博士",
  "text": "水蒸気が水滴になって、コップの外につくんだ。",
  "audio_sec": 3.84
 }
]