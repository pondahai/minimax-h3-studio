  "sid": "S01",
  "start": 8,
  "end": 12,
  "who": "メイ",
  "text": "中の水がもれてるのかな？",
  "audio_sec": 3.68
 },
 {
  "file": "S02_00_リン博士.wav",
  "sid": "S02",
  "start": 0,
  "end": 4,
  "who": "リン博士",
  "text": "じつは、わたしたちのまわりの空気には、",
