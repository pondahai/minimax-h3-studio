[
 {
  "file": "S01_00_小美.wav",
  "sid": "S01",
  "start": 0,
  "end": 3,
  "who": "小美",
  "text": "哇！太陽變黑了！",
  "audio_sec": 3.52
 },
 {
  "file": "S01_03_小明.wav",
  "sid": "S01",
  "start": 3,
  "end": 6,
  "who": "小明",
  "text": "這就是日食嗎？好神奇！",
  "audio_sec": 3.52
 },
 {
  "file": "S01_06_小美.wav",
  "sid": "S01",
  "start": 6,
  "end": 12,
  "who": "小美",
  "text": "月球跑到太陽和地球中間，把陽光遮住了！",
  "audio_sec": 6.56
 },
 {
  "file": "S02_00_旁白.wav",
  "sid": "S02",
  "start": 0,
  "end": 5,
  "who": "旁白",
  "text": "當月球走到太陽和地球中間，三個排成一直線，",
  "audio_sec": 4.64
 },
 {
  "file": "S02_05_旁白.wav",
  "sid": "S02",
  "start": 5,
  "end": 8,
  "who": "旁白",
  "text": "月球的影子就落在地球上，",
  "audio_sec": 3.2
 },
 {
  "file": "S02_08_旁白.wav",
  "sid": "S02",
  "start": 8,
  "end": 12,
  "who": "旁白",
  "text": "站在最暗的影子裡，就看不到太陽。",
  "audio_sec": 3.2
 },
 {
  "file": "S03_00_小美.wav",
  "sid": "S03",
  "start": 0,
  "end": 4,
  "who": "小美",
  "text": "太陽比月球大約四百倍，",
  "audio_sec": 3.68
 },
 {
  "file": "S03_04_小美.wav",
  "sid": "S03",
  "start": 4,
  "end": 8,
  "who": "小美",
  "text": "可是也遠了大約四百倍，",
  "audio_sec": 3.84
 },
 {
  "file": "S03_08_小美.wav",
  "sid": "S03",
  "start": 8,
  "end": 12,
  "who": "小美",
  "text": "所以從地球看，它們差不多大！",
  "audio_sec": 4.64
 },
 {
  "file": "S04_00_旁白.wav",
  "sid": "S04",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "月球完全遮住太陽，就是日全食，",
  "audio_sec": 3.2
 },
 {
  "file": "S04_04_旁白.wav",
  "sid": "S04",
  "start": 4,
  "end": 8,
  "who": "旁白",
  "text": "天空會變暗，",
  "audio_sec": 1.6
 },
 {
  "file": "S04_08_旁白.wav",
  "sid": "S04",
  "start": 8,
  "end": 12,
  "who": "旁白",
  "text": "只看得到太陽周圍像光芒的日冕。",
  "audio_sec": 2.88
 },
 {
  "file": "S05_00_旁白.wav",
  "sid": "S05",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "月球看起來小一點，",
  "audio_sec": 2.08
 },
 {
  "file": "S05_04_旁白.wav",
  "sid": "S05",
  "start": 4,
  "end": 8,
  "who": "旁白",
  "text": "遮不住整個太陽，",
  "audio_sec": 1.76
 },
 {
  "file": "S05_08_旁白.wav",
  "sid": "S05",
  "start": 8,
  "end": 12,
  "who": "旁白",
  "text": "就會留下一圈亮亮的火環，叫日環食。",
  "audio_sec": 4.16
 },
 {
  "file": "S06_00_小明.wav",
  "sid": "S06",
  "start": 0,
  "end": 3,
  "who": "小明",
  "text": "只遮住一部分，",
  "audio_sec": 2.24
 },
 {
  "file": "S06_03_小明.wav",
  "sid": "S06",
  "start": 3,
  "end": 5,
  "who": "小明",
  "text": "就是日偏食，",
  "audio_sec": 2.24
 },
 {
  "file": "S06_05_小明.wav",
  "sid": "S06",
  "start": 5,
  "end": 8,
  "who": "小明",
  "text": "太陽像被咬了一口！",
  "audio_sec": 2.72
 },
 {
  "file": "S06_08_小明.wav",
  "sid": "S06",
  "start": 8,
  "end": 12,
  "who": "小明",
  "text": "不同的地方，會看到不同的日食喔！",
  "audio_sec": 4.32
 },
 {
  "file": "S07_00_旁白.wav",
  "sid": "S07",
  "start": 0,
  "end": 4,
  "who": "旁白",
  "text": "月球的軌道斜了大約五度，",
  "audio_sec": 2.56
 },
 {
  "file": "S07_04_旁白.wav",
  "sid": "S07",
  "start": 4,
  "end": 9,
  "who": "旁白",
  "text": "所以月球的影子常常從地球上方或下方錯過。",
  "audio_sec": 4.48
 },
 {
  "file": "S08_00_小美.wav",
  "sid": "S08",
  "start": 0,
  "end": 4,
  "who": "小美",
  "text": "所以不是每個月都有日食，",
  "audio_sec": 4.16
 },
 {
  "file": "S08_04_小美.wav",
  "sid": "S08",
  "start": 4,
  "end": 8,
  "who": "小美",
  "text": "要剛好排成一直線才會發生喔！",
  "audio_sec": 4.8
 },
 {
  "file": "S09_00_小明.wav",
  "sid": "S09",
  "start": 0,
  "end": 3,
  "who": "小明",
  "text": "手電筒是太陽，大球是地球，",
  "audio_sec": 4.0
 },
 {
  "file": "S09_03_小美.wav",
  "sid": "S09",
  "start": 3,
  "end": 7,
  "who": "小美",
  "text": "小球是月球，移到中間……",
  "audio_sec": 4.64
 },
 {
  "file": "S09_07_小美.wav",
  "sid": "S09",
  "start": 7,
  "end": 12,
  "who": "小美",
  "text": "看！大球上出現小影子，就像日食！",
  "audio_sec": 6.08
 },
 {
  "file": "S10_00_小明.wav",
  "sid": "S10",
  "start": 0,
  "end": 4,
  "who": "小明",
  "text": "手電筒不要照別人的眼睛喔。",
  "audio_sec": 3.36
 },
 {
  "file": "S10_04_小美.wav",
  "sid": "S10",
  "start": 4,
  "end": 9,
  "who": "小美",
  "text": "只有影子落到的地方，才看得到日食。",
  "audio_sec": 5.6
 },
 {
  "file": "S11_00_小明.wav",
  "sid": "S11",
  "start": 0,
  "end": 3,
  "who": "小明",
  "text": "日食是月球擋住了太陽的光，",
  "audio_sec": 3.36
 },
 {
  "file": "S11_03_小明.wav",
  "sid": "S11",
  "start": 3,
  "end": 7,
  "who": "小明",
  "text": "月球雖小，看起來和太陽差不多大，",
  "audio_sec": 4.0
 },
 {
  "file": "S11_07_小明.wav",
  "sid": "S11",
  "start": 7,
  "end": 12,
  "who": "小明",
  "text": "日食有全食、環食和偏食！",
  "audio_sec": 5.28
 },
 {
  "file": "S12_00_小明.wav",
  "sid": "S12",
  "start": 0,
  "end": 4,
  "who": "小明",
  "text": "看太陽要戴合格的日食眼鏡，",
  "audio_sec": 3.52
 },
 {
  "file": "S12_04_小明.wav",
  "sid": "S12",
  "start": 4,
  "end": 8,
  "who": "小明",
  "text": "任何時候都不能直接看太陽，",
  "audio_sec": 3.36
 },
 {
  "file": "S12_08_小明.wav",
  "sid": "S12",
  "start": 8,
  "end": 12,
  "who": "小明",
  "text": "相機和望遠鏡要裝太陽濾鏡！",
  "audio_sec": 4.0
 }
]