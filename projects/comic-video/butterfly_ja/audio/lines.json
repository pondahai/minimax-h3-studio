[
 {
  "file": "S01_03_ミン.wav",
  "sid": "S01",
  "start": 3,
  "end": 7,
  "who": "ミン",
  "text": "わあ！小さな卵が、こんなにきれいなチョウになるんだ！",
  "audio_sec": 5.12
 },
 {
  "file": "S01_07_メイ.wav",
  "sid": "S01",
  "start": 7,
  "end": 10,
  "who": "メイ",
  "text": "チョウの成長を、いっしょに観察しよう！",
  "audio_sec": 5.12
 },
 {
  "file": "S02_00_ナレーター.wav",
  "sid": "S02",
  "start": 0,
  "end": 4,
  "who": "ナレーター",
  "text": "お母さんチョウは、幼虫が食べる植物の葉に卵を産みます。",
  "audio_sec": 4.96
 },
 {
  "file": "S02_04_ナレーター.wav",
  "sid": "S02",
  "start": 4,
  "end": 8,
  "who": "ナレーター",
  "text": "卵はとても小さく、形や色は種類によってちがいます。",
  "audio_sec": 4.64
 },
 {
  "file": "S02_08_ミン.wav",
  "sid": "S02",
  "start": 8,
  "end": 12,
  "who": "ミン",
  "text": "ちっちゃい！ここに新しい命がかくれてるんだ！",
  "audio_sec": 4.96
 },
 {
  "file": "S03_00_ナレーター.wav",
  "sid": "S03",
  "start": 0,
  "end": 4,
  "who": "ナレーター",
  "text": "卵がかえると、よく見るイモムシになります。",
  "audio_sec": 3.84
 },
 {
  "file": "S03_08_イモムシ.wav",
  "sid": "S03",
  "start": 8,
  "end": 12,
  "who": "イモムシ",
  "text": "おなかすいた！早く大きくなるぞ！",
  "audio_sec": 2.72
 },
 {
  "file": "S04_00_ナレーター.wav",
  "sid": "S04",
  "start": 0,
  "end": 4,
  "who": "ナレーター",
  "text": "いちばん大事な仕事は、葉っぱを食べること。",
  "audio_sec": 3.36
 },
 {
  "file": "S04_04_ナレーター.wav",
  "sid": "S04",
  "start": 4,
  "end": 9,
  "who": "ナレーター",
  "text": "何度も脱皮しながら、体は大きくなります。",
  "audio_sec": 3.68
 },
 {
  "file": "S04_09_ナレーター.wav",
  "sid": "S04",
  "start": 9,
  "end": 12,
  "who": "ナレーター",
  "text": "食べて、育って、脱皮して、また育つ！",
  "audio_sec": 3.84
 },
 {
  "file": "S05_00_ナレーター.wav",
  "sid": "S05",
  "start": 0,
  "end": 5,
  "who": "ナレーター",
  "text": "大きくなると、安全な場所でさなぎになります。",
  "audio_sec": 4.0
 },
 {
  "file": "S05_05_ナレーター.wav",
  "sid": "S05",
  "start": 5,
  "end": 8,
  "who": "ナレーター",
  "text": "静かに見えても、中では大変身中です。",
  "audio_sec": 3.84
 },
 {
  "file": "S05_08_メイ.wav",
  "sid": "S05",
  "start": 8,
  "end": 12,
  "who": "メイ",
  "text": "わあ！静かなのに、中で変身してるんだね！",
  "audio_sec": 6.24
 },
 {
  "file": "S06_00_ナレーター.wav",
  "sid": "S06",
  "start": 0,
  "end": 3,
  "who": "ナレーター",
  "text": "しばらくすると、さなぎが割れます。",
  "audio_sec": 2.72
 },
 {
  "file": "S06_08_ナレーター.wav",
  "sid": "S06",
  "start": 8,
  "end": 12,
  "who": "ナレーター",
  "text": "体液を羽に送って、ゆっくり広げます。",
  "audio_sec": 3.2
 },
 {
  "file": "S07_00_ナレーター.wav",
  "sid": "S07",
  "start": 0,
  "end": 4,
  "who": "ナレーター",
  "text": "羽がかわいてかたくなれば、飛べるようになります！",
  "audio_sec": 3.52
 },
 {
  "file": "S07_07_ミン.wav",
  "sid": "S07",
  "start": 7,
  "end": 10,
  "who": "ミン",
  "text": "やった！イモムシがきれいなチョウになった！",
  "audio_sec": 3.68
 },
 {
  "file": "S08_00_チョウ.wav",
  "sid": "S08",
  "start": 0,
  "end": 4,
  "who": "チョウ",
  "text": "花のみつ、おいしい！自然ってすてき！",
  "audio_sec": 6.08
 },
 {
  "file": "S08_04_ナレーター.wav",
  "sid": "S08",
  "start": 4,
  "end": 8,
  "who": "ナレーター",
  "text": "チョウはみつを吸いながら、花粉も運びます。",
  "audio_sec": 3.52
 },
 {
  "file": "S08_08_メイ.wav",
  "sid": "S08",
  "start": 8,
  "end": 12,
  "who": "メイ",
  "text": "チョウはきれいなだけじゃなく、自然の大切な仲間なんだね！",
  "audio_sec": 6.88
 },
 {
  "file": "S09_00_ナレーター.wav",
  "sid": "S09",
  "start": 0,
  "end": 4,
  "who": "ナレーター",
  "text": "おとなになると、チョウは交尾をして、",
  "audio_sec": 2.88
 },
 {
  "file": "S09_04_ナレーター.wav",
  "sid": "S09",
  "start": 4,
  "end": 8,
  "who": "ナレーター",
  "text": "メスがまた卵を産み、次の世代が始まります。",
  "audio_sec": 3.84
 },
 {
  "file": "S09_08_ナレーター.wav",
  "sid": "S09",
  "start": 8,
  "end": 12,
  "who": "ナレーター",
  "text": "卵、幼虫、さなぎ、成虫。命はめぐります。",
  "audio_sec": 5.28
 },
 {
  "file": "S10_00_ミン.wav",
  "sid": "S10",
  "start": 0,
  "end": 7,
  "who": "ミン",
  "text": "小さな命は、大きな自然とつながっている。みんなで美しい地球を守ろう！",
  "audio_sec": 7.36
 },
 {
  "file": "S10_08_ナレーター.wav",
  "sid": "S10",
  "start": 8,
  "end": 12,
  "who": "ナレーター",
  "text": "もっとたくさんの命が、飛び続けられるように！",
  "audio_sec": 3.68
 }
]